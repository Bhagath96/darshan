# Copy to .env.local (not committed) or set these in your host's build settings.
# All are optional. They are read at BUILD time (Vite inlines VITE_* variables).

# Mock API failure rate for every request, 0–1. Default: darshan 0.2, vazhipadu 0.1, other 0.05.
# Use a low value (e.g. 0.05) for a public demo, 0 for screenshots.
VITE_MOCK_FAILURE_RATE=

# Fixed mock API delay in milliseconds. Default: a random 200–1500 ms.
VITE_MOCK_LATENCY_MS=

# Set to true to allow ?fail=0.5 and ?latency=0 in the URL on a deployed build (demos).
# They always work in development (npm run dev).
VITE_MOCK_URL_PARAMS=false
